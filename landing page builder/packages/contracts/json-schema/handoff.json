{
  "$ref": "#/definitions/handoff",
  "definitions": {
    "handoff": {
      "type": "object",
      "properties": {
        "mission_id": {
          "type": "string",
          "minLength": 1
        },
        "feature": {
          "type": "string",
          "minLength": 1
        },
        "rol": {
          "type": "string",
          "enum": [
            "worker",
            "validador",
            "orquestador"
          ]
        },
        "modelo": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "completado",
            "parcial",
            "bloqueado"
          ]
        },
        "completado": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "pendiente": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "comandos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cmd": {
                "type": "string",
                "minLength": 1
              },
              "exit": {
                "type": "integer"
              }
            },
            "required": [
              "cmd",
              "exit"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "issues_descubiertos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "assertions_cubiertas": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "respeto_procedimientos": {
          "type": "boolean"
        },
        "artefacto_salida": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string"
        }
      },
      "required": [
        "mission_id",
        "feature",
        "rol",
        "modelo",
        "status",
        "respeto_procedimientos",
        "artefacto_salida"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

{
  "$ref": "#/definitions/tokens",
  "definitions": {
    "tokens": {
      "type": "object",
      "properties": {
        "mission_id": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
            },
            "secondary": {
              "$ref": "#/definitions/tokens/properties/color/properties/primary"
            },
            "surface": {
              "$ref": "#/definitions/tokens/properties/color/properties/primary"
            },
            "text": {
              "$ref": "#/definitions/tokens/properties/color/properties/primary"
            },
            "accent": {
              "$ref": "#/definitions/tokens/properties/color/properties/primary"
            }
          },
          "required": [
            "primary",
            "surface",
            "text"
          ],
          "additionalProperties": false
        },
        "typography": {
          "type": "object",
          "properties": {
            "headingFont": {
              "type": "string",
              "minLength": 1
            },
            "bodyFont": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "headingFont",
            "bodyFont"
          ],
          "additionalProperties": false
        },
        "logo": {
          "type": "object",
          "properties": {
            "tipo": {
              "type": "string",
              "enum": [
                "monograma",
                "real"
              ]
            },
            "valor": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "tipo",
            "valor"
          ],
          "additionalProperties": false
        },
        "radius": {
          "type": "string"
        }
      },
      "required": [
        "mission_id",
        "color",
        "typography",
        "logo"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

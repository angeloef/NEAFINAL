{
  "$ref": "#/definitions/mission_state",
  "definitions": {
    "mission_state": {
      "type": "object",
      "properties": {
        "mission_id": {
          "type": "string",
          "minLength": 1
        },
        "estado": {
          "type": "string",
          "enum": [
            "planificando",
            "ejecutando",
            "validando",
            "en_cola",
            "aprobado",
            "presentado"
          ]
        },
        "milestone_actual": {
          "type": "integer",
          "minimum": 0
        },
        "presupuesto": {
          "type": "object",
          "properties": {
            "tokens_max": {
              "type": "number",
              "minimum": 0
            },
            "tokens_usados": {
              "type": "number",
              "minimum": 0
            },
            "usd_max": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "tokens_max",
            "tokens_usados",
            "usd_max"
          ],
          "additionalProperties": false
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "estado": {
                "type": "string",
                "minLength": 1
              },
              "assertions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            },
            "required": [
              "id",
              "estado"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "validaciones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tipo": {
                "type": "string",
                "enum": [
                  "scrutiny",
                  "user_testing"
                ]
              },
              "resultado": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "assertions_falladas": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "tipo",
              "resultado"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "follow_up_features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "handoffs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "mission_id",
        "estado",
        "milestone_actual",
        "presupuesto"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

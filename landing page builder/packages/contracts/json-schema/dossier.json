{
  "$ref": "#/definitions/dossier",
  "definitions": {
    "dossier": {
      "type": "object",
      "properties": {
        "mission_id": {
          "type": "string",
          "minLength": 1
        },
        "entidad": {
          "type": "object",
          "properties": {
            "nombre": {
              "type": "object",
              "properties": {
                "valor": {
                  "type": "string",
                  "minLength": 1
                },
                "clase": {
                  "type": "string",
                  "enum": [
                    "VERIFICADO-OBLIG",
                    "VERIFICADO-OPC",
                    "PLANTILLA",
                    "INFERIDO"
                  ]
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "fecha": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              },
              "required": [
                "valor",
                "clase",
                "source",
                "confidence",
                "fecha"
              ],
              "additionalProperties": false
            },
            "tipo": {
              "$ref": "#/definitions/dossier/properties/entidad/properties/nombre"
            }
          },
          "required": [
            "nombre"
          ],
          "additionalProperties": false
        },
        "ubicacion": {
          "type": "object",
          "properties": {
            "ciudad": {
              "$ref": "#/definitions/dossier/properties/entidad/properties/nombre"
            },
            "zona": {
              "$ref": "#/definitions/dossier/properties/entidad/properties/nombre"
            },
            "direccion": {
              "$ref": "#/definitions/dossier/properties/entidad/properties/nombre"
            }
          },
          "required": [
            "ciudad"
          ],
          "additionalProperties": false
        },
        "contacto": {
          "type": "object",
          "properties": {
            "telefono": {
              "$ref": "#/definitions/dossier/properties/entidad/properties/nombre"
            },
            "whatsapp": {
              "$ref": "#/definitions/dossier/properties/entidad/properties/nombre"
            },
            "email": {
              "$ref": "#/definitions/dossier/properties/entidad/properties/nombre"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "place_id": {
          "$ref": "#/definitions/dossier/properties/entidad/properties/nombre"
        },
        "areas_practica": {
          "type": "object",
          "properties": {
            "valor": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "clase": {
              "$ref": "#/definitions/dossier/properties/entidad/properties/nombre/properties/clase"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "fecha": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "required": [
            "valor",
            "clase",
            "source",
            "confidence",
            "fecha"
          ],
          "additionalProperties": false
        },
        "prueba_social": {
          "type": "object",
          "properties": {
            "resenas": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "autor": {
                    "type": "string",
                    "minLength": 1
                  },
                  "texto": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rating": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "fecha": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                },
                "required": [
                  "autor",
                  "texto"
                ],
                "additionalProperties": false
              },
              "default": []
            }
          },
          "additionalProperties": false
        },
        "estado_web": {
          "type": "string",
          "enum": [
            "sin_web",
            "web_basica",
            "web_propia",
            "referencia"
          ]
        }
      },
      "required": [
        "mission_id",
        "entidad",
        "ubicacion"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

{
  "$ref": "#/definitions/copy",
  "definitions": {
    "copy": {
      "type": "object",
      "properties": {
        "mission_id": {
          "type": "string",
          "minLength": 1
        },
        "hero": {
          "type": "object",
          "properties": {
            "titulo": {
              "type": "string",
              "minLength": 1
            },
            "subtitulo": {
              "type": "string"
            },
            "cta_texto": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "titulo",
            "cta_texto"
          ],
          "additionalProperties": false
        },
        "areas_practica": {
          "type": "object",
          "properties": {
            "titulo": {
              "type": "string",
              "minLength": 1
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "titulo",
            "items"
          ],
          "additionalProperties": false
        },
        "prueba_social": {
          "type": "object",
          "properties": {
            "titulo": {
              "type": "string",
              "minLength": 1
            },
            "resenas": {
              "type": "array",

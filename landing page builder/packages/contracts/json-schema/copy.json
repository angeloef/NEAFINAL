                "type": "object",
                "properties": {
                  "autor": {
                    "type": "string",
                    "minLength": 1
                  },
                  "texto": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rating": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                  }
                },
                "required": [
                  "autor",
                  "texto"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "titulo",
            "resenas"
          ],
          "additionalProperties": false
        },
        "contacto": {
          "type": "object",
          "properties": {
            "titulo": {
              "type": "string",
              "minLength": 1
            },
            "telefono": {
              "type": "string"
            },
            "whatsapp": {
              "type": "string"
            },
            "email": {
              "type": "string",
              "format": "email"
            }
          },
          "required": [
            "titulo"
          ],
          "additionalProperties": false
        },
        "meta": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
